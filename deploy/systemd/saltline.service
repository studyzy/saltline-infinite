[Unit]
Description=Saltline co-op authority (HTTP + WebSocket)
Documentation=https://124.221.164.209/shoot/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/saltline-infinite
Environment=NODE_ENV=production
Environment=PORT=8091
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=2
# The room manager keeps in-memory state, so a restart drops live matches;
# stop cleanly and let clients reconnect inside their 90 s window.
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=saltline

# Nothing outside the repo needs to be writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/saltline-infinite

[Install]
WantedBy=multi-user.target
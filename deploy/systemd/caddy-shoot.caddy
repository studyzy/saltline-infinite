# Saltline — 浏览器 FPS：静态站 + co-op 权威服务
# 源 /home/ubuntu/saltline-infinite，静态发布 /var/www/shoot，线上 https://124.221.164.209/shoot/
# 后端 systemd: saltline.service（node server/index.js，127.0.0.1:8091）
redir /shoot /shoot/ 308

# 联机 WebSocket 不放在根路径 /ws —— 那个路径属于 pvz-shoot（同机另一款游戏，
# 它的 route 片段按字母序先加载，早就占了 /ws，连过去会收到它的 matchId/seat
# 协议）。盐线的 socket 跟着页面走：页面在 /shoot/，客户端连 /shoot/ws，
# 这里剥掉前缀再转给后端，后端仍然只认 /ws。
handle /shoot/ws {
	uri strip_prefix /shoot
	reverse_proxy 127.0.0.1:8091
}

handle_path /shoot/* {
	root * /var/www/shoot

	# 游戏是单个 2.2MB 的 js/game.js，文件名不含 hash，一律回源校验
	header Cache-Control "no-cache"
	header Content-Security-Policy "frame-ancestors 'self'"

	file_server
}